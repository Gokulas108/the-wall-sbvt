generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BlockName {
  id        Int      @id @default(autoincrement())
  blockId   String   @map("block_id")
  name      String
  qty       Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([blockId])
  @@map("block_names")
}

model BlockSubmission {
  id                Int            @id @default(autoincrement())
  blockId           String         @map("block_id")
  serialNumber      String?        @map("serial_number")
  actionType        String         @map("action_type")
  name              String
  qty               Int            @default(1)
  dateOfBirth       String         @map("date_of_birth")
  email             String
  phone             String
  whatsapp          String
  pledgeDueDays     Int?           @map("pledge_due_days")
  createdAt         DateTime       @default(now()) @map("created_at")
  collectedByUserId Int?           @map("collected_by_user_id")
  paymentMethod     String?        @map("payment_method")
  paymentReference  String?        @map("payment_reference")
  collectedByUser   DonorFormUser? @relation(fields: [collectedByUserId], references: [id])

  @@index([blockId])
  @@index([collectedByUserId])
  @@map("block_submissions")
}

model DonorFormUser {
  id                   Int                @id @default(autoincrement())
  username             String             @unique
  password             String
  role                 DonorFormRole
  isActive             Boolean            @default(true) @map("is_active")
  amountInCash         Int                @default(0) @map("amount_in_cash")
  amountTotal          Int                @default(0) @map("amount_total")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  amountPledge         Int                @default(0) @map("amount_pledge")
  amountSettled        Int                @default(0) @map("amount_settled")
  submissions          BlockSubmission[]
  settlementsPerformed CashSettlement[]   @relation("SettlementAdmin")
  settlementsReceived  CashSettlement[]   @relation("SettlementVolunteer")
  sessions             DonorFormSession[]

  @@map("donor_form_users")
}

model DonorFormSession {
  id        Int           @id @default(autoincrement())
  token     String        @unique
  expiresAt DateTime      @map("expires_at")
  createdAt DateTime      @default(now()) @map("created_at")
  userId    Int           @map("user_id")
  user      DonorFormUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("donor_form_sessions")
}

model CashSettlement {
  id          Int           @id @default(autoincrement())
  volunteerId Int           @map("volunteer_id")
  adminId     Int           @map("admin_id")
  amount      Int
  note        String?       @default("")
  createdAt   DateTime      @default(now()) @map("created_at")
  admin       DonorFormUser @relation("SettlementAdmin", fields: [adminId], references: [id])
  volunteer   DonorFormUser @relation("SettlementVolunteer", fields: [volunteerId], references: [id])

  @@index([volunteerId])
  @@index([adminId])
  @@map("cash_settlements")
}

model PendingTransaction {
  id          Int       @id @default(autoincrement())
  apiKey      String    @unique @map("api_key")
  blockId     String    @map("block_id")
  name        String
  qty         Int       @default(1)
  dateOfBirth String    @default("") @map("date_of_birth")
  email       String    @default("")
  phone       String
  whatsapp    String
  amount      Int
  status      String    @default("pending")
  txnId       String?   @map("txn_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([apiKey])
  @@index([status])
  @@map("pending_transactions")
}

model WhatsAppIntake {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  status    String   @default("awaiting_legal_name")
  donorName String?  @map("donor_name")
  donorQty  Int?     @map("donor_qty")
  donorBlockId String? @map("donor_block_id")
  donorSerial String? @map("donor_serial")
  donorEmail String? @map("donor_email")
  donorPhone String? @map("donor_phone")
  donorPaymentReference String? @map("donor_payment_reference")
  donorCreatedAt DateTime? @map("donor_created_at")
  legalName String?  @map("legal_name")
  address   String?
  pincode   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  @@index([status])
  @@index([expiresAt])
  @@map("whatsapp_intakes")
}

enum DonorFormRole {
  admin
  volunteer
}
